# content-diet 凭据模板：复制成 $CONTENT_DIET_HOME/.env 后填值（权限 600）
# 只有飞书三项是必需的，其余可选；缺了会降级，不会报错。详见 references/tokens.md

# ---------- 飞书（必需）----------
# open.feishu.cn/app → 创建企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人所在会话的 chat_id（oc_ 开头）；python3 setup/feishu_chats.py 可以列出来
FEISHU_CHAT_ID=

# ---------- Bangumi（可选）----------
# https://next.bgm.tv/demo/access-token 生成
BGM_API_TOKEN=

# ---------- 起点（可选，建议）----------
# 浏览器登录 qidian.com → F12 → 任意请求的 Cookie 头整串
QIDIAN_COOKIE=

# ---------- 网易云（可选，暂时用不到）----------
NETEASE_COOKIE=

# ---------- 代理（可选）----------
# Bangumi 在部分网络下直连不通时填这里
CONTENT_DIET_PROXY=
